{
    "name": "pharmacy-backend",
    "version": "1.0.0",
    "description": "Backend for Pharmacy Management System",
    "engines": {
        "node": ">=20"
    },
    "main": "dist/index.js",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "prisma generate && tsc -p tsconfig.build.json && mkdir -p dist/assets dist/docs && cp -R src/assets/. dist/assets/ && cp -f src/docs/openapi.json src/docs/openapi-rra.json dist/docs/ 2>/dev/null || true",
        "start": "prisma migrate deploy && node dist/index.js",
        "lint": "eslint --ext .ts src tests",
        "typecheck": "tsc --noEmit --project tsconfig.json",
        "test:unit": "vitest run",
        "test:jest": "jest --config jest.config.ts",
        "postinstall": "prisma generate",
        "smoke-test": "bash scripts/smoke-test.sh",
        "prisma:generate": "prisma generate",
        "prisma:migrate": "prisma migrate dev",
        "prisma:studio": "prisma studio",
        "prisma:deploy": "prisma migrate deploy",
        "build:seed": "tsc -p tsconfig.seed.json",
        "prisma:seed": "npm run build:seed && npx prisma db seed",
        "seed:super-admin": "tsx scripts/seed-super-admin.ts",
        "seed:reset": "npm run build:seed && prisma migrate reset --force && npm run post-seed-ebm",
        "post-seed-ebm": "tsx scripts/post-seed-ebm.ts",
        "ebm:test:setup": "tsx scripts/setup-ebm-test.ts",
        "ebm:test:topup-codes": "tsx scripts/topup-purchase-codes.ts",
        "ebm:test:seed-b2b-customers": "tsx scripts/create-test-b2b-customers.ts",
        "docs:generate": "tsx scripts/api-docs/generate.ts",
        "docs:inspect": "tsx scripts/api-docs/source.ts --inspect"
    },
    "prisma": {
        "seed": "node dist-seed/prisma/seed.js"
    },
    "dependencies": {
        "@kazion/dpopay-sdk": "^4.0.20",
        "@prisma/client": "^5.9.1",
        "@types/cron": "^2.4.3",
        "@types/request-ip": "^0.0.41",
        "@types/socket.io": "^3.0.2",
        "@types/stripe": "^8.0.417",
        "@types/winston": "^2.4.4",
        "@types/xlsx": "^0.0.36",
        "axios": "^1.13.2",
        "bcrypt": "^6.0.0",
        "bcryptjs": "^2.4.3",
        "cloudinary": "^2.8.0",
        "cors": "^2.8.5",
        "cron": "^4.3.5",
        "date-fns": "^4.1.0",
        "dotenv": "^16.4.1",
        "express": "^4.22.2",
        "express-rate-limit": "^8.2.1",
        "express-validator": "^7.0.1",
        "jsonwebtoken": "^9.0.2",
        "multer": "^2.0.2",
        "multer-storage-cloudinary": "^4.0.0",
        "node-cron": "^3.0.3",
        "nodemailer": "^6.9.8",
        "p-limit": "^5.0.0",
        "paypack-js": "^0.2.1",
        "pdfkit": "^0.17.2",
        "qrcode": "^1.5.4",
        "request-ip": "^3.3.0",
        "socket.io": "^4.8.1",
        "stripe": "^20.0.0",
        "swagger-ui-express": "^5.0.1",
        "ts-node": "^10.9.2",
        "winston": "^3.18.3",
        "xlsx": "^0.18.5",
        "zod": "^4.1.12",
        "zod-express-middleware": "^1.4.0"
    },
    "devDependencies": {
        "@apidevtools/swagger-parser": "^13.0.0",
        "@types/bcryptjs": "^2.4.6",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/jest": "^30.0.0",
        "@types/jsonwebtoken": "^9.0.5",
        "@types/multer": "^2.0.0",
        "@types/node": "^24.10.1",
        "@types/node-cron": "^3.0.11",
        "@types/nodemailer": "^6.4.14",
        "@types/p-limit": "^2.2.0",
        "@types/pdfkit": "^0.17.6",
        "@types/qrcode": "^1.5.6",
        "@types/swagger-ui-express": "^4.1.8",
        "@typescript-eslint/eslint-plugin": "^6.7.0",
        "@typescript-eslint/parser": "^6.7.0",
        "eslint": "^8.48.0",
        "jest": "^30.4.2",
        "prisma": "^5.9.1",
        "ts-jest": "^29.4.11",
        "tsx": "^4.7.0",
        "typescript": "^5.9.3",
        "vitest": "^1.4.1"
    },
    "resolutions": {
        "@types/express": "4.17.21",
        "@types/express-serve-static-core": "4.17.37"
    }
}
