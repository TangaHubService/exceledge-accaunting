# Prefer a dedicated Accounting database in production.
DATABASE_URL=postgresql://USER:PASS@localhost:5432/accounting?schema=public

# Must match Excel Edge ERP JWT_SECRET for end-user AuthN
JWT_SECRET=change-me-to-match-erp-jwt-secret

PORT=4600
CORS_ORIGIN=http://localhost:5174
INTEGRATION_API_KEY=dev-integration-key

# Excel Edge ERP API, called with the signed-in user's token (e.g. to request an opening stock snapshot).
ERP_API_URL=http://localhost:4500/api

# Number of proxies in front of the API, so the audit trail records real client addresses.
TRUST_PROXY=0

# Outgoing email for customer invoices, statements and reminders (any SMTP server; Gmail needs an app password)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
# MAIL_TRANSPORT=json   # log emails instead of sending (tests, local dev)
