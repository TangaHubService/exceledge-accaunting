# Stripe Configuration
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Paypack Configuration
PAYPACK_API_URL=https://api.paypack.rw
PAYPACK_CLIENT_ID=your_paypack_client_id
PAYPACK_CLIENT_SECRET=your_paypack_client_secret
# HMAC secret Paypack signs the X-Paypack-Signature header with. Get this from
# your Paypack merchant dashboard's webhook settings for the registered
# webhook URL (<API_URL>/api/webhooks/paypack) — without it every incoming
# webhook is rejected with 500 before signature verification even runs.
PAYPACK_WEBHOOK_SECRET=your_paypack_webhook_secret

# API Configuration
API_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3001

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/your_database

# JWT Configuration
JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=7d

# Email Configuration (Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM=your_email@gmail.com

# PESAPAL Configuration (sandbox)
PESAPAL_CONSUMER_KEY=wCGzX1fNzvtI5lMR5M4AxvxBmLpFgZzp
PESAPAL_CONSUMER_SECRET=uU7R9g2IHn9dkrKDVIfcPppktIo=
PESAPAL_API_URL=https://cybqa.pesapal.com/pesapalv3/api
# Register an IPN URL at https://cybqa.pesapal.com and replace this value
PESAPAL_IPN_ID=your_pesapal_ipn_id_from_dashboard

# RRA EBM / VSDC (obtain spec and URLs from RRA cis_sdc_certification@rra.gov.rw)
ENABLE_EBM=false
EBM_API_URL=
EBM_API_KEY=
EBM_API_SECRET=
EBM_SECURITY_KEY=Z60gftKe9sei3xOZhvvDa0StkVILKR3j5MBM9ygi1zg=
EBM_ENVIRONMENT=sandbox
EBM_SALE_PATH=/trnsSales/saveSales
EBM_REFUND_PATH=/trnsSales/saveSales
EBM_VOID_PATH=/trnsSales/saveSales
EBM_ITEM_PATH=/saveItem
EBM_MOVEMENT_PATH=/selectMvmt
EBM_PURCHASE_PATH=/savePurc
EBM_REQUEST_TIMEOUT_MS=30000
EBM_USE_MOCK=false
EBM_MAX_QUEUE_RETRIES=10
EBM_STATUS_CHECK_PATH=/status
# Strict fiscal mode (2018 spec Art. 10, strict reading): when true, a sale is
# not created unless the VSDC is reachable and confirms. Default false keeps
# the outbox behavior (sale completes, official receipt withheld till confirmed).
EBM_STRICT_MODE=false
# Electronic Journal transmission (2018 Art. 6.5 EJ_DATA). The 2023 VSDC API
# defines no EJ endpoint, so leave empty to store the journal locally only.
# Set to the device EJ path when RRA provides one; ejSent is true only on ack.
EBM_EJ_SYNC_PATH=
# Offline block window in ms (2023 spec 2.2: VSDC stops issuing numbers after
# 24h without internet). Defaults to 24h when unset.
VSDC_OFFLINE_BLOCK_MS=86400000

# Accounting microservice integration (Phase 3)
ACCOUNTING_INTEGRATION_ENABLED=true
ACCOUNTING_API_URL=http://localhost:4600
# Accounting web app origin(s), comma-separated. Allowed by CORS so it can sign in with ERP accounts.
ACCOUNTING_WEB_URL=http://localhost:5174
ACCOUNTING_INTEGRATION_API_KEY=dev-integration-key
